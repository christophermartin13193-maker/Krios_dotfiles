{
	// POSITION
    "layer": "bottom",
    "position": "bottom",
	"margin-bottom": 13,
	"margin-left": 10,
	"margin-right": 10,
	"exclusive": true,
	// SIZE
	"width": 960,
    // MODULE
	"modules-left": [ "hyprland/workspaces" ],
	"modules-center": [ "network", "clock", "pulseaudio"],



    // Modules configuration
    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
			//  󰖟 󰊗 󰿎  
            "1": "",
            "2": "󰖟",
            "3": "",
            "4": "󰊗",
            "5": "󰿎",
			"6": "",
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },

	"network": {
		"format-wifi": "{icon} {signalStrength}%",
		"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
		"format-ethernet": " Connecté",
		"format-disconnected": "󰤮 Déconnecté",
		"tooltip-format": "IP : {ipaddr}/{cidr}\nFréquence : {frequency}",
		//"on-click": "alacritty -e nmtui"
		"on-click": "nm-connection-editor"
	},

	"clock": {
		"format": " {:%H:%M}",
		"format-alt": " {:%Y-%m-%d}",
		"tooltip": false
	},
	
	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": "{icon} 󰝟",
		"format-icons": {
			"headphone": "",
			"headset": "",
			"speaker": "󰓃",
			"hdmi": "󰔂",
			"default": ["", "", ""]
		},
		//"on-click": "alacritty -e pulsemixer",
		"on-click": "pavucontrol",
		"tooltip-format": "Périphérique : {desc}"
	}

}
