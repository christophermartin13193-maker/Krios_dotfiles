* {
	yellow		: rgba(209, 210, 91, 1);
	orange		: rgba(171, 98, 61, 1);
	red			: rgba(143, 25, 40, 1);
	dark-green  : rgba(2, 39, 32, 1);
	light-green : rgba(64, 88, 24, 1);
	purple		: rgba(80, 25, 82, 1);
	frozen		: rgba(149, 235, 231, 1);
	shadow		: rgba(17, 6, 31, 1);
}

window {
	location: north;
	anchor: center;
	x-offset: 0px;
	y-offset: 13px;
	width: 520px;
	padding: 20px;

	background-color: transparent;
}

mainbox {
	background-color: transparent;
}

inputbar {
	children: [ entry ];
	border: 2px;
	border-radius: 12px 12px 0px 0px;
	padding: 8px;
	margin: 0px 0px 18px 0px;

	background-color: transparent;
	background-image: linear-gradient(88deg, rgba(17, 6, 31, 0.85), rgba(22, 14, 36, 0.85));
	border-color: rgba(17, 6, 31, 0.85);
}

entry {
	font: "JetBrainsMono NF ExtraBold 15";
	placeholder: "Rechercher...";
	padding: 2px;
	border-radius: 0px;

	background-color: transparent;
	text-color: @yellow;
}

listview {
	cycle: true;
	lines: 8;
	columns: 1;
	border: 2px;
	border-radius: 0px 0px 12px 12px;
	padding: 8px;
	spacing: 2px;

	background-color: transparent;
	background-image: linear-gradient(76deg, rgba(17, 6, 31, 0.85), rgba(2, 39, 32, 0.85));
	border-color: rgba(17, 6, 31, 0.85);
}

element {
	padding: 2px 2px 2px 12px;
}

element normal {
	background-color: transparent;
}

element-text {
	font: "JetBrainsMono NF 15";	
	background-color: transparent;
	text-color: @frozen;
}

element-icon {
	background-color: transparent;
}

element-text normal {
	border: 0px 0px 2px 0px;
	border-radius: 0px;
	border-color: rgba(64, 88, 24, 0.85);
}

element-text selected {
	border: 0px 2px 2px 0px;
	border-radius: 0px 12px 0px 0px;
	background-color: transparent;
	text-color: @yellow;
	border-color: @red;
}
